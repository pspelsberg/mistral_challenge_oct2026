# Mistral AI Studio API Configuration
# Mandatory model for gameplay: mistral-large-4
MISTRAL_API_KEY=your_mistral_api_key_here
ROGUE_MODEL_ID=mistral-large-4

# Safety, Latency, and Budget Guardrails (Section 12)
ROGUE_MAX_TURNS=100
ROGUE_MAX_API_CALLS=120
ROGUE_MAX_SESSION_SECONDS=1800
ROGUE_MAX_BUDGET_USD=1.00
ROGUE_REQUEST_TIMEOUT_SECONDS=30.0
ROGUE_MAX_RETRIES=3

# Backend Configuration
ROGUE_TERMINAL_BINARY=./bin/rogue
ROGUE_STEAM_APP_ID=1443430
ROGUE_STEAM_INSTALL_DIR=/home/peppi/.local/share/Steam/steamapps/common/Rogue
ROGUE_STEAM_SCREENSHOT_BACKUP_ONLY=true
ROGUE_RUNS_DIR=./runs
